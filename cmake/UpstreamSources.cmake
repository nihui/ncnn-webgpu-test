function(require_upstream_checkout name directory revision)
    find_package(Git REQUIRED)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${directory}" rev-parse HEAD
        RESULT_VARIABLE status OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT status EQUAL 0 OR NOT actual STREQUAL revision)
        message(FATAL_ERROR "${name} must be a checkout of ${revision}; got ${actual}")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${directory}" status --porcelain --untracked-files=no
        RESULT_VARIABLE status OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT status EQUAL 0 OR changes)
        message(FATAL_ERROR "${name} checkout must be clean; browser patches belong in the build directory")
    endif()
endfunction()

# Copy only specified upstream files, then apply a reviewable context patch.
# The original checkout stays clean, and unchanged inputs preserve object mtimes.
function(prepare_upstream_sources name directory patch_file)
    find_program(PATCH_EXECUTABLE patch REQUIRED)
    set(destination "${CMAKE_CURRENT_BINARY_DIR}/upstream/${name}")
    file(SHA256 "${patch_file}" signature)
    foreach(relative IN LISTS ARGN)
        file(SHA256 "${directory}/${relative}" checksum)
        string(APPEND signature "\n${relative}:${checksum}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${directory}/${relative}")
    endforeach()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${patch_file}")
    string(SHA256 signature "${signature}")
    set(previous "")
    if(EXISTS "${destination}/.adapted-signature")
        file(READ "${destination}/.adapted-signature" previous)
    endif()
    foreach(relative IN LISTS ARGN)
        if(NOT EXISTS "${destination}/${relative}")
            set(previous "")
        endif()
    endforeach()
    if(NOT previous STREQUAL signature)
        file(REMOVE_RECURSE "${destination}")
        foreach(relative IN LISTS ARGN)
            get_filename_component(parent "${relative}" DIRECTORY)
            file(MAKE_DIRECTORY "${destination}/${parent}")
            configure_file("${directory}/${relative}" "${destination}/${relative}" COPYONLY)
        endforeach()
        execute_process(COMMAND "${PATCH_EXECUTABLE}" --batch --forward --fuzz=0 -p1
                --directory "${destination}" --input "${patch_file}"
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "${name} upstream patch failed:\n${output}${error}")
        endif()
        file(WRITE "${destination}/.adapted-signature" "${signature}")
    endif()
    set(${name}_ADAPTED_SOURCE_DIR "${destination}" PARENT_SCOPE)
endfunction()
